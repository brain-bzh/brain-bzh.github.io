<div class="theme-switcher" role="radiogroup" aria-label="Colour theme">
  <button type="button" class="theme-choice" role="radio" aria-checked="true" data-theme-choice="light" title="Light theme">
    <span class="theme-swatch" aria-hidden="true"></span><span class="theme-choice-label">Light</span>
  </button>
  <button type="button" class="theme-choice" role="radio" aria-checked="false" tabindex="-1" data-theme-choice="dark" title="Dark theme">
    <span class="theme-swatch" aria-hidden="true"></span><span class="theme-choice-label">Dark</span>
  </button>
  <button type="button" class="theme-choice" role="radio" aria-checked="false" tabindex="-1" data-theme-choice="green" title="Green theme">
    <span class="theme-swatch" aria-hidden="true"></span><span class="theme-choice-label">Green</span>
  </button>
</div>
